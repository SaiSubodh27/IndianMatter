# Copy to .env.local and adjust for your environment.
# Base URL of the IndianMatter FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000
VITE_TOPATH_URL=http://localhost:8000

# Supabase configuration for research papers (read-only anon access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder
