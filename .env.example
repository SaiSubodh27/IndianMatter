# ==============================================================================
# IndianMatter Docker Compose Environment Configuration (.env.example)
# Copy to `.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Configuration
# ------------------------------------------------------------------------------
MONGO_URL=mongodb://mongodb:27017/IndianMaterialsAI
MONGO_PORT=27017

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Configuration
# ------------------------------------------------------------------------------
PORT=8000
BACKEND_PORT=8000
# Materials Project API Key (from https://next-gen.materialsproject.org/api)
MP_API_KEY=your_materials_project_api_key_here
SESSION_SECRET=change-this-to-a-secure-random-secret-string

# Optional OAuth credentials for backend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. Vite React Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_TOPATH_URL=http://localhost:8000

# Supabase configuration for literature papers (read-only anon access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder

# ------------------------------------------------------------------------------
# 4. n8n Workflow Automation Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
# 32-character hexadecimal encryption key used to encrypt/decrypt credentials.
# IMPORTANT: Keep this stable across container restarts to preserve credentials.
N8N_ENCRYPTION_KEY=your_32_char_hex_encryption_key_here

N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
